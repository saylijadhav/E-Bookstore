# Copy to .env (git-ignored, chmod 600). Never commit real values.
PORT=4000
HOST=127.0.0.1
# Password is generated when you create the role; see README.
DATABASE_URL=postgresql://bookworm_app:CHANGE_ME@127.0.0.1:5432/bookworm
# Integration tests refuse to run unless this database name contains "_test".
TEST_DATABASE_URL=postgresql://bookworm_app:CHANGE_ME@127.0.0.1:5432/bookworm_test
# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_______
CORS_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
